<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080D12"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="24dp">

        <!-- Centered Card with Teal Accent Border -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_alarm_card"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="22dp">

            <!-- Top Header: ALARM REMINDER badge (left) & Sound ON (right) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/badgeAlarmReminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_alarm_badge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="🔔 ALARM REMINDER"
                    android:textColor="#F87171"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textSoundStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="🔊 Sound ON"
                    android:textColor="#F87171"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Habit Initial Squircle Avatar -->
            <TextView
                android:id="@+id/textHabitInitial"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_alarm_avatar"
                android:gravity="center"
                android:text="R"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Habit Name Heading -->
            <TextView
                android:id="@+id/textAlarmTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="React learning"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Streak Badge -->
            <TextView
                android:id="@+id/textStreakBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_alarm_streak"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="5dp"
                android:text="🔥 Start Streak"
                android:textColor="#F59E0B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Motivational Subtitle / Streak-at-stake line -->
            <TextView
                android:id="@+id/textAlarmBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Day 1 starts right now. Make it count."
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <!-- Motivational Quote Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_alarm_quote"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/textQuoteContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="&quot;We are what we repeatedly do. Excellence, then, is not an act, but a habit.&quot;"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/textQuoteAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="— Aristotle"
                    android:textColor="#3D7A75"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Main Action: ✓ Mark Done -->
            <Button
                android:id="@+id/btnDismiss"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_btn_mark_done"
                android:backgroundTint="@null"
                android:text="✓ Mark Done"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Secondary Action: +10 min (Only Snooze Option) -->
            <Button
                android:id="@+id/btnSnooze"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_snooze"
                android:backgroundTint="@null"
                android:text="+10 min"
                android:textColor="#CBD5E1"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Recurring Reminder Notice -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="This reminder will continue on its regular schedule until you mark it done. Snoozing only delays this alert by 10 minutes."
                android:textColor="#94A3B8"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
